<%- include('partials/header') %>
<!-- 등록, 수정 화면 같이 씀 (action 주소만 다름) -->

<div class="toolbar">
  <h2><%= title %></h2>
  <a class="btn" href="/">목록으로</a>
</div>

<div class="card form-card">
  <form method="post" action="<%= action %>">
    <label>
      메뉴 이름
      <input type="text" name="name" value="<%= menu.name %>" maxlength="50" required>
    </label>

    <label>
      가격 (원)
      <input type="number" name="price" value="<%= menu.price %>" min="0" required>
    </label>

    <label>
      카테고리
      <select name="category">
        <% for (let c of categories) { %>
          <option value="<%= c %>" <%= menu.category == c ? 'selected' : '' %>><%= c %></option>
        <% } %>
      </select>
    </label>

    <div class="actions">
      <a class="btn" href="/">취소</a>
      <button class="btn primary" type="submit">저장</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
