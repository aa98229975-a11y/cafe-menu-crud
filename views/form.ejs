<%- include('partials/header') %>

<div class="toolbar">
  <h2><%= title %></h2>
  <a class="btn" href="/">← 목록으로</a>
</div>

<div class="card form-card">
  <% if (errors.length) { %>
    <ul class="errors">
      <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>

  <form method="post" action="<%= action %>">
    <label>
      메뉴 이름
      <input type="text" name="name" value="<%= menu.name %>" maxlength="50" placeholder="예) 아메리카노" required autofocus>
    </label>

    <label>
      가격 (원)
      <input type="number" name="price" value="<%= menu.price %>" min="0" max="1000000" placeholder="예) 2000" required>
    </label>

    <label>
      카테고리
      <select name="category" required>
        <% const options = categories.includes(menu.category) || !menu.category ? categories : [...categories, menu.category]; %>
        <% options.forEach((c) => { %>
          <option value="<%= c %>" <%= menu.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>

    <div class="actions">
      <a class="btn" href="/">취소</a>
      <button class="btn primary" type="submit"><%= submitLabel %></button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
